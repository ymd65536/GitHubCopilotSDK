<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../otel-collector.yaml" Link="otel-collector.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../prometheus.yml" Link="prometheus.yml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../grafana-datasources.yaml" Link="grafana-datasources.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
